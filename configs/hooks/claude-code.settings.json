{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <project_root>/configs/hooks/guard_pre_tool.py --host claude",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
