{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <project_root>/configs/hooks/guard_pre_tool.py --host antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
