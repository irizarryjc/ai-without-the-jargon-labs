{
  "mcpServers": {
    "lab-docs-readonly": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2.4.0",
        "--read-only",
        "<project_root>/lab-docs"
      ]
    },
    "northwind-readonly": {
      "command": "python3",
      "args": [
        "<project_root>/labs/ch18-mcp-server/server.py",
        "--db",
        "<project_root>/labs/ch18-mcp-server/northwind_lab.db"
      ]
    }
  }
}
