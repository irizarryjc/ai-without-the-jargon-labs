{
  "_comment": "Format as of November 2026; save as <project_root>/.mcp.json for Claude Code (or adapt for Cursor .cursor/mcp.json and Kiro .kiro/settings/mcp.json). Check current vendor docs.",
  "mcpServers": {
    "lab-docs-readonly": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--read-only",
        "<project_root>/lab-docs"
      ]
    },
    "northwind-readonly": {
      "command": "python3",
      "args": [
        "<project_root>/labs/ch18-mcp-server/server.py",
        "--db",
        "<project_root>/labs/ch18-mcp-server/northwind_lab.db"
      ]
    }
  }
}
